{
  "name": "whisky-manager",
  "private": true,
  "type": "module",
  "description": "Naver cafe management automation for the whisky/cognac club",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "build:extension": "vite build --config vite.config.ts",
    "start": "pnpm build:all && electron .",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:all": "pnpm build && pnpm build:renderer && pnpm build:extension",
    "probe": "pnpm build && node scripts/probe.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/chrome": "^0.2.7",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.4.1",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "i18next": "^26.4.0",
    "node-html-parser": "^9.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "main": "dist/desktop/main.js"
}
