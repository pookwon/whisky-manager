{
  "name": "whisky-manager",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Naver cafe management automation for the whisky/cognac club",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:collection:generate": "drizzle-kit generate --config drizzle.collection.config.ts",
    "db:collection:migrate": "node scripts/migrate-collection-db.mjs",
    "test:collection:integration": "node scripts/run-collection-integration.mjs",
    "build:extension": "vite build --config vite.config.ts",
    "build:extension:dev": "WM_EXTENSION_CHANNEL=development vite build --config vite.config.ts",
    "start": "pnpm build:all && electron .",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:all": "pnpm build && pnpm build:preload && pnpm build:renderer && pnpm build:extension",
    "package:app": "pnpm build:all && electron-builder --publish never",
    "package:app:mac": "pnpm build:all && electron-builder --mac dmg --publish never",
    "package:app:win": "pnpm build:all && electron-builder --win msi --publish never",
    "package:extension": "pnpm build:extension && node scripts/package-extension.mjs",
    "probe": "pnpm build && node scripts/probe.mjs",
    "capture:cafe-articles": "pnpm build && node scripts/capture-cafe-articles.mjs",
    "capture:cafe-members": "pnpm build && node scripts/capture-cafe-members.mjs",
    "generate:cp949": "node scripts/generate-cp949.mjs",
    "dry-run": "pnpm build && node scripts/dry-run.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/chrome": "^0.2.7",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.4.1",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.5",
    "iconv-lite": "^0.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "node-html-parser": "^9.0.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "main": "dist/desktop/main.js",
  "build": {
    "appId": "com.whiskymanager.app",
    "productName": "Whisky Manager",
    "asar": true,
    "asarUnpack": ["**/*.node"],
    "files": ["dist/**/*", "drizzle/**/*", "drizzle-collection/**/*", "assets/tray-icon*.png", "package.json", "!**/*.map"],
    "directories": { "output": "release" },
    "mac": {
      "category": "public.app-category.business",
      "target": ["dmg"],
      "extendInfo": {
        "CFBundleDisplayName": "Naver Cafe Manager"
      }
    },
    "win": {
      "icon": "assets/whisky-manager.ico",
      "target": ["msi"],
      "artifactName": "Whisky-Manager-${version}.${ext}"
    },
    "linux": {
      "category": "Office",
      "target": ["AppImage"]
    }
  }
}
